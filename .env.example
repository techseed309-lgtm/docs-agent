# Copy this file to .env and fill in real values. .env is gitignored; this file is not —
# never put a real secret in .env.example.

# ---------------------------------------------------------------------------
# Postgres (serves both the n8n database and the vectors database, one instance)
# ---------------------------------------------------------------------------
# Superuser used by the postgres container itself and by db/init/01-databases.sql
# to create the n8n and vectors databases. Pick any values; they're internal to
# this stack.
POSTGRES_USER=
POSTGRES_PASSWORD=
# Maintenance database the postgres image connects to on boot before init scripts
# run. Leave as "postgres" unless you have a reason to change it.
POSTGRES_DB=postgres

# ---------------------------------------------------------------------------
# n8n
# ---------------------------------------------------------------------------
# Port n8n's web UI and webhooks are exposed on (host side).
N8N_PORT=5678
# Decrypts every credential n8n has stored. Generate once with:
#   openssl rand -hex 32
# BACK THIS UP SEPARATELY FROM THE DATABASE. Losing it after credentials exist
# makes every stored credential unrecoverable, even from a good DB backup.
N8N_ENCRYPTION_KEY=
# IANA timezone n8n uses for schedules and displayed timestamps.
GENERIC_TIMEZONE=Africa/Lagos
# Public URL n8n should use when building webhook URLs (e.g. a cloudflared
# tunnel URL during a demo). Leave empty for local-only use.
WEBHOOK_URL=
# API key for scripts/n8n_api.py to call n8n's REST API (Settings > n8n API in
# the UI, created after n8n is up). Empty until you generate one.
N8N_API_KEY=
# Base URL scripts/n8n_api.py talks to. Default matches N8N_PORT above.
N8N_API_BASE_URL=http://localhost:5678

# ---------------------------------------------------------------------------
# Vectors database (same Postgres instance, separate database — see db/init/)
# ---------------------------------------------------------------------------
VECTORS_DB_HOST=localhost
VECTORS_DB_PORT=5432
VECTORS_DB_NAME=vectors
# Reuses the Postgres superuser above; fine for a single-tenant local stack.
VECTORS_DB_USER=
VECTORS_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Models — never hardcode a model name in a workflow; read it from here instead.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Retrieval / chat webhook (used from M2 onward)
# ---------------------------------------------------------------------------
# Cosine-similarity floor below which the chat workflow refuses to answer
# instead of guessing.
RELEVANCE_THRESHOLD=0.75
# Number of chunks retrieved per question.
RETRIEVAL_TOP_K=5
# Shared secret the chat webhook requires as a header (added in M5).
WEBHOOK_SHARED_SECRET=
