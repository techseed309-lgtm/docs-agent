    {
      "id": "read-files",
      "name": "Read PDFs",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        240,
        380
      ],
      "parameters": {
        "operation": "read",
        "fileSelector": "/data/corpus/sample/*.pdf",
        "options": {}
      }
    },
    {
      "id": "extract-pdf",
      "name": "Extract from File",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        460,
        380
      ],
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "data"
      }
    },
    {
      "id": "prepare-document",
      "name": "Prepare Document",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        380
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const crypto = require('crypto');\nconst fileName = $('Read PDFs').item.binary.data.fileName || 'unknown.pdf';\nconst text = ($json.text || '').replace(/\\u0000/g, '');\nconst contentSha = crypto.createHash('sha256').update(text).digest('hex');\nconst title = fileName.replace(/\\.pdf$/i, '');\nreturn {\n  json: {\n    source_path: `corpus/sample/${fileName}`,\n    title,\n    tenant: 'default',\n    content_sha: contentSha,\n    text\n  }\n};"
      }
    },
    {
      "id": "check-existing",
      "name": "Check Existing",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        900,
        380
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT $1::text AS tenant, $2::text AS source_path, $3::text AS title,\n       $4::text AS content_sha, $5::text AS text,\n       (d.content_sha IS DISTINCT FROM $4) AS needs_reingest\nFROM (SELECT 1) AS dummy\nLEFT JOIN documents d ON d.tenant = $1 AND d.source_path = $2",
        "options": {
          "queryReplacement": "={{ [$json.tenant, $json.source_path, $json.title, $json.content_sha, $json.text] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "7TdAKcnF24wxLqXE",
          "name": "Postgres (vectors)"
        }
      }
    },
    {
      "id": "filter-changed",
      "name": "Filter Changed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        380
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return items.filter(item => item.json.needs_reingest === true);"
      }
    },
    {
      "id": "upsert-document",
      "name": "Upsert Document",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1340,
        380
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO documents (tenant, source_path, title, content_sha)\nVALUES ($1, $2, $3, $4)\nON CONFLICT (tenant, source_path)\nDO UPDATE SET content_sha = EXCLUDED.content_sha, title = EXCLUDED.title, ingested_at = now()\nRETURNING id, tenant, $5::text AS text",
        "options": {
          "queryReplacement": "={{ [$json.tenant, $json.source_path, $json.title, $json.content_sha, $json.text] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "7TdAKcnF24wxLqXE",
          "name": "Postgres (vectors)"
        }
      }
    },
    {
      "id": "delete-old-chunks",
      "name": "Delete Old Chunks",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1560,
        380
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH deleted AS (\n  DELETE FROM chunks WHERE document_id = $1\n  RETURNING 1\n)\nSELECT $1::bigint AS document_id, $2::text AS tenant, $3::text AS text, COUNT(*) AS deleted_count\nFROM deleted",
        "options": {
          "queryReplacement": "={{ [$json.id, $json.tenant, $json.text] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "7TdAKcnF24wxLqXE",
          "name": "Postgres (vectors)"
        }
      }
    },
    {
      "id": "chunk-text",
      "name": "Chunk Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        380
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const CHUNK_SIZE = 1200; // characters -- M1 baseline, tuned in M4 (see PLAN.md)\nconst CHUNK_OVERLAP = 150;\n\nconst output = [];\nfor (let i = 0; i < items.length; i++) {\n  const documentId = items[i].json.document_id;\n  const tenant = items[i].json.tenant;\n  const text = items[i].json.text;\n\n  let start = 0;\n  let chunkIndex = 0;\n  while (start < text.length) {\n    const end = Math.min(start + CHUNK_SIZE, text.length);\n    const content = text.slice(start, end);\n    output.push({\n      json: {\n        document_id: documentId,\n        tenant,\n        chunk_index: chunkIndex,\n        content,\n        token_count: Math.ceil(content.length / 4)\n      }\n    });\n    chunkIndex++;\n    if (end === text.length) break;\n    start = end - CHUNK_OVERLAP;\n  }\n}\nreturn output;"
      }
    },
    {
      "id": "loop-chunks",
      "name": "Loop Over Chunks",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        2000,
        380
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "embed-chunk",
      "name": "Embed Chunk",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2220,
        280
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OLLAMA_BASE_URL }}/api/embeddings",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.EMBEDDING_MODEL, prompt: $json.content }) }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "insert-chunk",
      "name": "Insert Chunk",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2440,
        280
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO chunks (document_id, tenant, chunk_index, content, token_count, embedding)\nVALUES ($1, $2, $3, $4, $5, $6::vector)",
        "options": {
          "queryReplacement": "={{ [$('Chunk Text').item.json.document_id, $('Chunk Text').item.json.tenant, $('Chunk Text').item.json.chunk_index, $('Chunk Text').item.json.content, $('Chunk Text').item.json.token_count, '[' + $json.embedding.join(',') + ']'] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "7TdAKcnF24wxLqXE",
          "name": "Postgres (vectors)"
        }
      }
    },
    {
      "id": "note-triggers",
      "name": "Sticky Note - Triggers",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -40
      ],
      "parameters": {
        "content": "## Three ways to run this\n- **Manual**: click Execute Workflow, for testing\n- **Schedule**: daily, automatic (production path)\n- **Webhook**: `POST /webhook/ingest-trigger` -- for on-demand runs, e.g. right after adding a new document to corpus/sample/",
        "height": 200,
        "width": 700,
        "color": 4
      }
    },
    {
      "id": "note-dedup",
      "name": "Sticky Note - Dedup",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        900,
        620
      ],
      "parameters": {
        "content": "## Skip unchanged documents\nHashes each doc's extracted text (SHA-256) and compares to what's already stored. Unchanged docs are filtered out right here -- nothing downstream (chunking, embedding, DB writes) re-runs for them.\n\nFiltering happens in a Code node, not a SQL WHERE guard -- see PLAN.md's M1 section for why (a real bug: Postgres nodes here collapse to one ambiguous item when every row in a batch returns zero results).",
        "height": 220,
        "width": 660,
        "color": 5
      }
    },
    {
      "id": "note-throttle",
      "name": "Sticky Note - Throttle",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        2000,
        620
      ],
      "parameters": {
        "content": "## Sequential on purpose\nOllama (CPU, self-hosted) only has one processing slot. Firing embedding requests concurrently queues them behind each other until n8n's own timeout kills them -- this loop (batch size 1) keeps them strictly sequential instead. The HTTP node's own \"batching\" option did NOT achieve this in testing; this Split In Batches loop did.",
        "height": 220,
        "width": 660,
        "color": 3
      }
    }
  ],
